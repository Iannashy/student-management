<!DOCTYPE html>
<html>

<head>

    <title>Student Management</title>

    <link rel="stylesheet" href="/css/style.css">

</head>

<body>

    <header>

        <h1>Student Management System</h1>

        <nav>

            <a href="/">Student List</a>

            <a href="/students/add">Add Student</a>

        </nav>

    </header>

    <div class="container">

        <h2 class="page-title">Student List</h2>

        <div class="search-area">

            <form
                action="/students/search"
                method="GET"
                style="display: flex; gap: 10px; flex: 1;"
            >

                <input
                    type="text"
                    name="keyword"
                    placeholder="Search student..."
                >

                <button type="submit">Search</button>

            </form>

            <a href="/students/add" class="btn btn-add">
                Add Student
            </a>

        </div>

        <div class="table-container">

            <table>

                <tr>

                    <th>ID</th>

                    <th>Student ID</th>

                    <th>Name</th>

                    <th>Course</th>

                    <th>Year</th>

                    <th>Email</th>

                    <th>Actions</th>

                </tr>

                <% students.forEach(student => { %>

                <tr>

                    <td><%= student.id %></td>

                    <td><%= student.student_id %></td>

                    <td>
                        <%= student.first_name %>
                        <%= student.last_name %>
                    </td>

                    <td><%= student.course %></td>

                    <td><%= student.year_level %></td>

                    <td><%= student.email %></td>

                    <td>

                        <div class="actions">

                            <a
                                href="/students/edit/<%= student.id %>"
                                class="btn btn-edit"
                            >
                                Edit
                            </a>

                            <form
                                action="/students/delete"
                                method="POST"
                            >

                                <input
                                    type="hidden"
                                    name="id"
                                    value="<%= student.id %>"
                                >

                                <button
                                    type="submit"
                                    class="btn-delete"
                                >
                                    Delete
                                </button>

                            </form>

                        </div>

                    </td>

                </tr>

                <% }); %>

            </table>

        </div>

    </div>

</body>

</html>